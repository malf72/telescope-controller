; Quadrature decoder for RP2040/RP2350 PIO (after the Raspberry Pi pico-examples design).
; Input pins: A on base pin, B on base pin + 1 (must be consecutive GPIOs).
; MUST be loaded at instruction address 0 (computed jump table).
; The signed count lives in the Y register and is pushed to the RX FIFO continuously.

.program quadrature_encoder
.origin 0

    JMP update          ; old 00, new 00
    JMP decrement       ; old 00, new 01
    JMP increment       ; old 00, new 10
    JMP update          ; old 00, new 11

    JMP increment       ; old 01, new 00
    JMP update          ; old 01, new 01
    JMP update          ; old 01, new 10
    JMP decrement       ; old 01, new 11

    JMP decrement       ; old 10, new 00
    JMP update          ; old 10, new 01
    JMP update          ; old 10, new 10
    JMP increment       ; old 10, new 11

    JMP update          ; old 11, new 00
    JMP increment       ; old 11, new 01
decrement:
    JMP Y--, update     ; old 11, new 10 (acts as a pure decrement)

.wrap_target
update:                 ; also the entry for old 11, new 11 (address 15)
    MOV ISR, Y
    PUSH noblock

sample_pins:
    OUT ISR, 2          ; previous pin state (2 bits) from OSR (shifts right)
    IN PINS, 2          ; new pin state, giving old<<2 | new
    MOV OSR, ISR        ; remember for next pass
    MOV PC, ISR         ; computed jump into the table

increment:
    MOV Y, ~Y
    JMP Y--, increment_cont
increment_cont:
    MOV Y, ~Y
.wrap
